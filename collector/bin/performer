#!/usr/bin/env python3
"""performer entry point.

Deliberately dependency free and path independent: copy the whole ``collector``
directory (plus ``schema``) onto a target machine and run this file.  No
install step, no virtualenv, no network.
"""

import sys
from pathlib import Path

if sys.version_info < (3, 8):
    sys.exit("performer needs Python 3.8 or newer (found %s)" % sys.version.split()[0])

# collector/bin/performer -> add collector/ to the import path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from performer.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
