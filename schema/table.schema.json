{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zaryob/performer/schema/table.schema.json",
  "title": "Normalised aggregation table",
  "description": "A keyed bpftrace map after post processing, e.g. futex wait time per uaddr or total time per syscall. Column oriented metadata plus row arrays so the viewer can sort without guessing types.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "name", "columns", "rows"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "table" },
    "name": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/column" }
    },
    "rows": {
      "description": "Each row is an array of values positionally matching columns. null means 'not measured'.",
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": ["string", "number", "boolean", "null"] }
      }
    },
    "truncated": {
      "description": "True when the collector kept only the top N rows.",
      "type": "boolean"
    },
    "total_rows": {
      "description": "Row count before truncation.",
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$" },
        "label": { "type": "string" },
        "type": { "enum": ["string", "int", "float", "hex", "stack"] },
        "unit": { "enum": ["us", "ns", "ms", "s", "bytes", "count", "pct", "none"] },
        "sort": {
          "description": "Hint for the viewer's default sort direction.",
          "enum": ["asc", "desc"]
        }
      }
    }
  }
}
