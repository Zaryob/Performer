/*
 * futex.bt -- lock contention, attributed to individual locks.
 *
 *   $1  target pid (tgid)
 *   $2  watchdog seconds
 *   $3  minimum wait to record, in microseconds
 *
 * The highest value probe in the set. Aggregating by `uaddr` is what makes it
 * possible to say *which* mutex is hot rather than merely that futex time is
 * high: if one or two addresses dominate the total, that is a single
 * contended lock, and @futex_us shows the code paths that take it.
 *
 * uaddr is recorded as an integer and formatted as hex in post-processing.
 * The address is only meaningful within one run of one process -- it is an
 * identity, not something to compare across runs.
 */

tracepoint:syscalls:sys_enter_futex
/ pid == $1 /
{
    @fx_start[tid] = nsecs;
    @fx_addr[tid] = (uint64) args->uaddr;
    @fx_op[tid] = args->op;
}

tracepoint:syscalls:sys_exit_futex
/ @fx_start[tid] /
{
    $waited_us = (nsecs - @fx_start[tid]) / 1000;
    if ($waited_us >= $3) {
        @futex_us[ustack]                 = sum($waited_us);
        @futex_by_addr[@fx_addr[tid]]     = sum($waited_us);
        @futex_cnt_by_addr[@fx_addr[tid]] = count();
        @futex_hist                       = hist($waited_us);
    }
    delete(@fx_start[tid]);
    delete(@fx_addr[tid]);
    delete(@fx_op[tid]);
}

interval:s:$2
{
    exit();
}

END
{
    clear(@fx_start);
    clear(@fx_addr);
    clear(@fx_op);
}
