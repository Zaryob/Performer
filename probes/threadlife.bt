/*
 * threadlife.bt -- thread creation and exit.
 *
 *   $1  target pid (tgid)
 *   $2  watchdog seconds
 *
 * A pool that churns is a different problem from a pool that is merely large.
 * The 1 Hz /proc series shows the thread count moving; this shows whether
 * that movement is the same threads or new ones, and which code path creates
 * them.
 * sched_process_fork runs in the creating thread. Its parent_pid is that
 * thread's TID; bpftrace's pid is the shared TGID used by the exit filter.
 */

tracepoint:sched:sched_process_fork
/ pid == $1 /
{
    @fork_cnt[args->parent_comm] = count();
    @_born_at[args->child_pid] = nsecs;
}

tracepoint:sched:sched_process_exit
/ pid == $1 /
{
    @exit_cnt[comm] = count();
    if (@_born_at[tid]) {
        @thread_lifetime_ms = hist((nsecs - @_born_at[tid]) / 1000000);
        delete(@_born_at[tid]);
    }
}

// The banner is printed before kernel attachment completes. This event can
// run only after the probe is active; the collector starts its clock here.
interval:ms:100
{
    if (!@_performer_ready) {
        printf("PERFORMER_READY\n");
        @_performer_ready = 1;
    }
}

interval:s:$2
{
    exit();
}
