/*
 * Thread lifecycle for one TGID. $1 = TGID, $2 = watchdog seconds,
 * $3 = retained events per CPU (collector default divides a 2048-event budget).
 * task_newtask's CLONE_THREAD flag excludes forked child processes.
 * Event timestamps and birth timestamps use the shared BOOTTIME clock.
 * Counters/histograms continue after the event budget is exhausted.
 */
tracepoint:task:task_newtask
/ pid == $1 && (args->clone_flags & 0x10000) != 0 /
{
    $now = nsecs;
    @fork_cnt[comm] = count();
    @_born_at[args->pid] = $now;
    @_parent_tid[args->pid] = tid;
    if (@_event_count[cpu] < $3) {
        @thread_event[$now, 1, args->pid, tid, args->comm, $now] = 1;
        @_event_count[cpu] = @_event_count[cpu] + 1;
    } else {
        @thread_events_dropped = count();
    }
}

tracepoint:sched:sched_process_exit
/ pid == $1 /
{
    $now = nsecs;
    @exit_cnt[comm] = count();
    $born = @_born_at[tid];
    if ($born && $now >= $born) {
        @thread_lifetime_ms = hist(($now - $born) / 1000000);
    }
    if (@_event_count[cpu] < $3) {
        @thread_event[$now, 2, tid, @_parent_tid[tid], comm, $born] = 1;
        @_event_count[cpu] = @_event_count[cpu] + 1;
    } else {
        @thread_events_dropped = count();
    }
    delete(@_born_at[tid]);
    delete(@_parent_tid[tid]);
}

interval:ms:100
{
    if (!@_performer_ready) {
        printf("PERFORMER_READY\n");
        @_performer_ready = 1;
    }
}

interval:s:$2
{
    exit();
}
